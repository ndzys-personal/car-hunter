{
  "name": "car-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "baseline": "tsx src/jobs/baseline.ts",
    "scan": "tsx src/jobs/scan.ts",
    "telegram:chat-id": "tsx src/telegram/get-chat-id.ts",
    "telegram:test": "tsx src/telegram/send-test.ts",
    "test:telegram": "tsx src/telegram/send-test.ts",
    "analyze": "tsx src/jobs/analyze.ts",
    "test": "vitest run",
    "test:watch": "vitest",
