    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
