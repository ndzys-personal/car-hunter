# Supabase (use the service-role key only on trusted machines/CI)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_DIRECT_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Broad marketplace searches prepared manually for every profile
OTOMOTO_E91_URL=
OTOMOTO_E61_URL=
OLX_E91_URL=
OLX_E61_URL=
ALLEGRO_E91_URL=
ALLEGRO_E61_URL=

# Runtime controls
HEADLESS=true
MAX_LISTINGS_PER_SOURCE=100
MAX_SEARCH_PAGES=10
DETAIL_CONCURRENCY=3
AI_SCORE_THRESHOLD=55
HISTORY_SEARCH_ENABLED=true
HISTORY_SEARCH_TTL_DAYS=7
LOG_LEVEL=info
